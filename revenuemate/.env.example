# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=revenuemate
POSTGRES_PASSWORD=revenuemate
POSTGRES_DB=revenuemate
DATABASE_URL=postgresql+psycopg://revenuemate:revenuemate@localhost:5432/revenuemate
LLM_API_KEY=
LLM_MODEL=
# Real WhatsApp for the demo, mock payments by design.
MESSAGING_PROVIDER=whatsapp
PAYMENT_PROVIDER=mock
# Paytm is post-event; leave these empty.
PAYTM_ENV=staging
PAYTM_MID=
PAYTM_MERCHANT_KEY=
# WhatsApp Cloud API (Meta developer dashboard). Use a permanent system-user token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Owner WhatsApp number: international format, digits only.
OWNER_CONTACT=
# Public HTTPS URL of this API (tunnel) for the webhook and demo payment links.
PUBLIC_BASE_URL=http://localhost:8000
STOCK_STALE_MINUTES=60
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
